{
  "name": "zotero-pdf-translate",
  "version": "1.0.0",
  "private": true,
  "description": "Zotero 划词翻译插件：在 PDF/EPUB 阅读器中选中文本后点击悬浮按钮即可查看译文（Google 免费接口 / MyMemory / OpenAI 兼容接口）",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheJieee/zotero-pdf-translate.git"
  },
  "homepage": "https://github.com/TheJieee/zotero-pdf-translate",
  "bugs": {
    "url": "https://github.com/TheJieee/zotero-pdf-translate/issues"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node test/run.mjs",
    "check": "node scripts/check.mjs",
    "verify": "node scripts/verify.mjs",
    "update-manifest": "node scripts/make-update-manifest.mjs",
    "release": "node scripts/build.mjs && node scripts/make-update-manifest.mjs",
    "icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-icons.ps1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "AGPL-3.0-or-later"
}
