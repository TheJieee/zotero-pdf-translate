{
  "manifest_version": 2,
  "name": "PDF Translate",
  "version": "1.0.0",
  "description": "划词翻译：在 Zotero 阅读器中选中 PDF/EPUB 文本后点击悬浮按钮即可查看译文。支持 Google 免费接口、MyMemory 与 OpenAI 兼容接口。",
  "author": "TheJieee",
  "homepage_url": "https://github.com/TheJieee/zotero-pdf-translate",
  "icons": {
    "48": "content/icons/icon-48.png",
    "96": "content/icons/icon-96.png"
  },
  "applications": {
    "zotero": {
      "id": "zotero-pdf-translate@example.com",
      "update_url": "https://github.com/TheJieee/zotero-pdf-translate/releases/latest/download/updates.json",
      "strict_min_version": "7.0",
      "strict_max_version": "10.0.*"
    }
  }
}
